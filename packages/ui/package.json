{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
